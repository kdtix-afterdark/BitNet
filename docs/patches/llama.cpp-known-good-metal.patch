         message(STATUS "BLAS found, Libraries: ${BLAS_LIBRARIES}")
 
+        if (APPLE AND (${GGML_BLAS_VENDOR} MATCHES "Apple") AND ("${BLAS_INCLUDE_DIRS}" STREQUAL ""))
+            find_path(BLAS_INCLUDE_DIRS
