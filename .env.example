# BitNet broker recommended environment profile
#
# Usage:
#   set -a
#   source ./.env.example
#   set +a
#   python3 run_broker.py
#
# CLI flags still work and override these values for one-off runs.

BITNET_WORKSPACE_ROOT=/Users/ckreager/repos/kdtix/LLMs/BitNet

# Recommended broker + model runtime profile
# BITNET_BROKER_MODEL=${BITNET_WORKSPACE_ROOT}/models/bitnet-b1.58-2B-4T-bf16/ggml-model-f32-bitnet.gguf
BITNET_BROKER_MODEL=${BITNET_WORKSPACE_ROOT}/models/BitNet-b1.58-2B-4T/ggml-model-i2_s.gguf
BITNET_LLAMA_BUILD_DIR=${BITNET_WORKSPACE_ROOT}/build-metal
BITNET_LLAMA_SERVER_PATH=${BITNET_LLAMA_BUILD_DIR}/bin/llama-server

BITNET_BROKER_HOST=127.0.0.1
BITNET_BROKER_PORT=8091
BITNET_LLAMA_HOST=127.0.0.1
BITNET_LLAMA_PORT=8080

BITNET_BROKER_GPU_LAYERS=999
BITNET_BROKER_THREADS=10
# CTX for BITNET was traied at 4096, but 8192 was stable.
BITNET_BROKER_CTX_SIZE=4096
BITNET_BROKER_N_PREDICT=4096
BITNET_BROKER_N_KEEP=-1
BITNET_BROKER_TEMPERATURE=0.5
BITNET_BROKER_TOP_P=0.9

BITNET_BROKER_STARTUP_TIMEOUT=120
BITNET_BROKER_REQUEST_TIMEOUT=180
BITNET_BROKER_LOG_LEVEL=3
BITNET_BROKER_VERBOSE=3

BITNET_BROKER_LOG_DIR=${BITNET_WORKSPACE_ROOT}/broker_logs
BITNET_BROKER_STATE_DIR=${BITNET_WORKSPACE_ROOT}/broker_state
BITNET_BROKER_SYSTEM_PROMPTS_DIR=${BITNET_WORKSPACE_ROOT}/broker/system_prompts
# BITNET_BROKER_SYSTEM_PROMPT=${BITNET_BROKER_SYSTEM_PROMPTS_DIR}/default.system.prompt.md
# Example prompt override:
BITNET_BROKER_SYSTEM_PROMPT=${BITNET_BROKER_SYSTEM_PROMPTS_DIR}/kdtix.system.prompt.md

BITNET_MCP_CONFIG=${BITNET_WORKSPACE_ROOT}/broker/mcp_servers.json
BITNET_MCP_STARTUP_TIMEOUT=30
BITNET_MCP_REQUEST_TIMEOUT=60
BITNET_MCP_PROTOCOL_VERSION=2025-03-26

# Durable lifecycle tuning
BITNET_BROKER_SNAPSHOT_TURN_INTERVAL=3
# Verbatim turns retained in snapshots before older turns roll into the recovered summary
BITNET_BROKER_SNAPSHOT_HISTORY_TURNS=8
BITNET_BROKER_HEARTBEAT_INTERVAL_SECONDS=30
BITNET_BROKER_MEMORY_SYNC_ENABLED=1
BITNET_BROKER_MEMORY_SYNC_RETRY_SECONDS=15

# Root-cause debugging traces
BITNET_BROKER_TRACE_TURNS=1
BITNET_BROKER_TRACE_DIR=${BITNET_WORKSPACE_ROOT}/broker_traces
